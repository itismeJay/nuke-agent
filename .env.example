# Copy to .env.local and fill in. .env.local is gitignored.
# Values for the Nook Supabase project live in the Supabase dashboard:
#   Project Settings -> API  (URL + publishable/anon key)

# --- Supabase (public: safe to expose to the browser) ------------------------
# Project API URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Public by design;
# row-level security is what protects data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (secret: server-only, never prefixed NEXT_PUBLIC) --------------
# service_role key. Bypasses RLS. Used by the Inngest résumé parse workflow
# (lib/supabase/admin.ts) — it runs with no user session, reads the private
# Storage object, and writes resume_import rows scoped to the event's user_id.
# For the local stack: `npx supabase status` -> SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (secret: server-only) --------------------------------------
# Résumé transcription (lib/resume/parse-pipeline.ts) is currently wired to
# Gemini (lib/ai/gemini.ts) — TEMPORARY, D-025, until Anthropic API billing is
# set up. Only one of these needs to be set; whichever matches the import in
# parse-pipeline.ts.
#
# Gemini: https://aistudio.google.com/apikey (free tier; Flash-tier models only
# unless billing is enabled — see the comment on RESUME_EXTRACTION_MODEL)
GEMINI_API_KEY=
#
# Anthropic (intended long-term provider, D-022): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Inngest (durable background workflows) --------------------------------
# Local dev: set INNGEST_DEV=1 in .env.local (inngest@4+ defaults to "cloud
# mode" and demands a signing key otherwise). Then run
# `npx inngest-cli@latest dev` alongside `npm run dev` — it discovers
# http://localhost:3000/api/inngest.
# EVENT_KEY / SIGNING_KEY are not needed locally; required in deployed
# environments (from the Inngest dashboard, per env):
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL of this app. Used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
